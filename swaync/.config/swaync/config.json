{
  "$schema": "/etc/xdg/swaync/configSchema.json",
  "ignore-gtk-theme": true,
  "cssPriority": "user",
  "positionX": "right",
  "positionY": "top",
  "layer": "overlay",
  "control-center-layer": "top",
  "layer-shell": true,
  "layer-shell-cover-screen": true,
  "notification-window-preferred-output": "DP-2",
  "control-center-margin-top": 8,
  "control-center-margin-bottom": 8,
  "control-center-margin-right": 24,
  "control-center-margin-left": 0,
  "control-center-width": 480,
  "fit-to-screen": true,
  "notification-window-width": 480,
  "notification-icon-size": 56,
  "notification-body-image-height": 100,
  "notification-body-image-width": 200,
  "notification-2fa-action": true,
  "notification-inline-replies": false,
  "notification-grouping": true,
  "image-visibility": "when-available",
  "timeout": 6,
  "timeout-low": 4,
  "timeout-critical": 0,
  "relative-timestamps": true,
  "keyboard-shortcuts": true,
  "transition-time": 200,
  "hide-on-clear": false,
  "hide-on-action": true,
  "script-fail-notify": true,
  "text-empty": "No Notifications",
  "widgets": [
    "title",
    "notifications",
    "mpris",
    "volume",
    "buttons-grid"
  ],
  "widget-config": {
    "title": {
      "text": "Notifications",
      "clear-all-button": true,
      "button-text": "Clear"
    },
    "notifications": {
      "vexpand": true
    },
    "mpris": {
      "blacklist": [
        "playerctld",
        "^plexamp$",
        "\\.plexamp$"
      ],
      "autohide": true,
      "show-album-art": "always",
      "image-size": 64
    },
    "volume": {
      "label": "󰕾",
      "show-per-app": false
    },
    "buttons-grid": {
      "buttons-per-row": 2,
      "actions": [
        {
          "label": "󰂛   Do Not Disturb",
          "type": "toggle",
          "command": "swaync-client -d -sw",
          "update-command": "swaync-client -D -sw"
        },
        {
          "label": "󰖂   Exit node",
          "type": "toggle",
          "command": "sh -c '$HOME/.config/waybar/scripts/tailscale-exit toggle'",
          "update-command": "sh -c 'tailscale status --json | jq -e \"[.Peer[] | select(.ExitNode)] | length > 0\" >/dev/null && echo true || echo false'"
        },
        {
          "label": "󰓃   Audio output",
          "command": "sh -c '$HOME/.config/waybar/scripts/sink cycle'"
        },
        {
          "label": "󰹑   Screenshot",
          "command": "sh -c 'swaync-client -cp -sw; sleep 0.3; niri msg action screenshot'"
        }
      ]
    }
  }
}