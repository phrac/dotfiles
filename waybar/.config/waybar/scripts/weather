#!/usr/bin/env bash
# Current conditions from a Wunderground personal weather station (PWS) for waybar.
# Set station= to your PWS ID.
# API key (free for PWS owners: wunderground.com/member/api-keys) goes in:
#   ~/.config/waybar/wunderground.key
station="YOUR_STATION_ID"
keyfile="$HOME/.config/waybar/wunderground.key"

if [[ ! -s $keyfile ]]; then
  echo '{"text":"󰖐 key?","class":"unavailable","tooltip":"Weather\nStatus  no API key\n\nPut your Wunderground key in ~/.config/waybar/wunderground.key"}'
  exit 0
fi
key=$(tr -d '[:space:]' <"$keyfile")

json=$(curl -sf --max-time 10 \
  "https://api.weather.com/v2/pws/observations/current?stationId=$station&format=json&units=e&numericPrecision=decimal&apiKey=$key") ||
  { echo '{"text":"󰖐 --","class":"unavailable","tooltip":"Weather\nStatus  Wunderground request failed"}'; exit 0; }

# Daily forecast for the station's location. One request an hour, shared by every
# monitor's copy of this module (the key allows 1500 calls a day).
fcache=${XDG_RUNTIME_DIR:-/tmp}/waybar-forecast.json
forecast=$(
  exec 9>"$fcache.lock"; flock 9
  if [[ -s $fcache ]] && (( $(date +%s) - $(stat -c %Y "$fcache") < 3600 )); then
    cat "$fcache"
  else
    geo=$(jq -r '.observations[0] | "\(.lat),\(.lon)"' <<<"$json")
    if fc=$(curl -sf --max-time 10 \
        "https://api.weather.com/v3/wx/forecast/daily/5day?geocode=$geo&format=json&units=e&language=en-US&apiKey=$key") &&
       jq -e '.dayOfWeek' <<<"$fc" >/dev/null 2>&1; then
      printf '%s' "$fc" > "$fcache"; printf '%s' "$fc"
    elif [[ -s $fcache ]]; then
      cat "$fcache"   # keep showing the last forecast if the refresh fails
    else
      echo '{}'
    fi
  fi
)

jq -c --arg station "$station" --argjson fc "${forecast:-"{}"}" '
  .observations[0] as $o | $o.imperial as $i
  | def r: if . == null then "--" else (. | round | tostring) end;
    def compass: if . == null then "" else
      ["N","NNE","NE","ENE","E","ESE","SE","SSE","S","SSW","SW","WSW","W","WNW","NW","NNW"][((. + 11.25) / 22.5 | floor) % 16] end;
    # The forecast high for today goes null once it has passed; use the calendar-day high then.
    def day($n): if $fc.dayOfWeek == null then empty else
      ($fc.daypart[0]) as $dp
      | (($fc.temperatureMax[$n] // $fc.calendarDayTemperatureMax[$n]) | r) as $hi
      | ($fc.temperatureMin[$n] | r) as $lo
      | ([$dp.precipChance[$n*2], $dp.precipChance[$n*2+1]] | map(select(. != null)) | max) as $pop
      | ($dp.wxPhraseLong[$n*2] // $dp.wxPhraseLong[$n*2+1]) as $wx
      | "\($hi)° / \($lo)°  \($wx // "")\(if ($pop // 0) > 0 then ", \($pop)% rain" else "" end)" end;
    ($i.temp) as $t
  | (if $t == null then $i.temp
     elif $t >= 80 and $i.heatIndex != null then $i.heatIndex
     elif $t <= 50 and $i.windChill != null then $i.windChill
     else $t end) as $feels
  | (if ($i.precipRate // 0) > 0 then "󰖗"
     elif $o.solarRadiation == null then "󰔏"
     elif $o.solarRadiation >= 300 then "󰖙"
     elif $o.solarRadiation > 5 then "󰖕"
     else "󰖔" end) as $icon
  | {
      text: "<span color=\"#ebcb8b\">\($icon)</span> \($t | r)°",
      class: (if $t == null then "unavailable" elif $t >= 90 then "hot" elif $t <= 32 then "cold" else "normal" end),
      tooltip: ([
        "\($o.neighborhood // $station) (\($station))",
        "Temp       \($t | r)°F  (feels \($feels | r)°)",
        (day(0) | "Today      \(.)"),
        (day(1) | "Tomorrow   \(.)"),
        "Humidity   \($o.humidity | r)%  · dew point \($i.dewpt | r)°",
        "Wind       \($o.winddir | compass) \($i.windSpeed | r) mph, gust \($i.windGust | r)",
        "Pressure   \($i.pressure // "--") inHg",
        "Rain       \($i.precipTotal // 0) in today  (\($i.precipRate // 0) in/hr)",
        (if $o.uv != null then "UV         \($o.uv | r)" else empty end),
        "Updated    \($o.obsTimeLocal | split(" ")[1][0:5])"
      ] | join("\n"))
    }' <<<"$json" 2>/dev/null ||
  echo '{"text":"󰖐 --","class":"unavailable","tooltip":"Weather\nStatus  unexpected response from Wunderground"}'
